Cell[BoxData[
 RowBox[{
  RowBox[{"compose", "[", 
   RowBox[{"U_", ",", "V_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"adjU", ",", "adjV"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"adjU", "=", 
