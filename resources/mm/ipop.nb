Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"model", "[", 
    RowBox[{"k_", "?", "NumberQ"}], "]"}], ":=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"model", "[", "k", "]"}], "=", 
     RowBox[{"First", "[", 
      RowBox[{"p", "/.", 
       RowBox[{"NDSolve", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"p", "'"}], "[", "t", "]"}], "==", 
            RowBox[{
             RowBox[{"r", "[", "1", "]"}], 
             RowBox[{"p", "[", "t", "]"}], 
             RowBox[{"(", 
              RowBox[{"1", "-", 
               RowBox[{
                RowBox[{"p", "[", "t", "]"}], "/", "k"}]}], ")"}]}]}], ",", 
           RowBox[{
            RowBox[{"p", "[", "0", "]"}], "==", "p0"}]}], "}"}], ",", "p", ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "100"}], "}"}]}], "]"}]}], "]"}]}], 
    ")"}]}], ";"}]], "Input",
