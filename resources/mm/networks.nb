Cell[BoxData[
 RowBox[{
  SubscriptBox["g", "i_"], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"out", ",", "in", ",", "neighbors", ",", "verts"}], "}"}], ",", 
    "\n", 
    RowBox[{
     RowBox[{"out", "=", 
      RowBox[{"Flatten", "@", 
       RowBox[{"Position", "[", 
        RowBox[{
         RowBox[{"M", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", 
         RowBox[{"_", "?", "Positive"}]}], "]"}]}]}], ";", "\n", 
     RowBox[{"in", "=", 
      RowBox[{"Flatten", "@", 
       RowBox[{"Position", "[", 
        RowBox[{
         RowBox[{"M", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "i"}], "]"}], "]"}], ",", 
         RowBox[{"_", "?", "Positive"}]}], "]"}]}]}], ";", "\n", 
     RowBox[{"neighbors", "=", 
      RowBox[{"Union", "[", 
       RowBox[{"out", ",", "in"}], "]"}]}], ";", "\n", 
     RowBox[{"verts", "=", 
      RowBox[{"Prepend", "[", 
       RowBox[{"neighbors", ",", "i"}], "]"}]}], ";", "\n", 
