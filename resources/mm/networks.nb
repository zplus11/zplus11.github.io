 RowBox[{"Length", "[", "coms", "]"}]], "Input",
 CellChangeTimes->{{3.983671024811863*^9, 3.9836710265941677`*^9}},
 CellLabel->"In[42]:=",ExpressionUUID->"ec3d6a76-f158-3644-89af-5d573a0247e8"],

Cell["there are 8 communities of", "Text",
 CellChangeTimes->{{3.983671028092228*^9, 
  3.9836710313592434`*^9}},ExpressionUUID->"0e41e3ba-f656-9d45-82b2-\
711df41bf264"],

Cell[BoxData[
 RowBox[{"VertexCount", "/@", "coms"}]], "Input",
