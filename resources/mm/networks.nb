1241c4699358"],

Cell[BoxData[
 RowBox[{"EdgeCount", "/@", "coms"}]], "Input",
 CellChangeTimes->{{3.9836710639635773`*^9, 3.983671065230013*^9}, {
  3.983671147711933*^9, 3.983671148352556*^9}},
 CellLabel->"In[44]:=",ExpressionUUID->"490c1ff5-362a-c543-af88-6ce08a306c91"],

Cell["\<\
These communities have this many interactions in them. Graph densities:\
\>", "Text",
 CellChangeTimes->{{3.9836710689346924`*^9, 3.9836710777982025`*^9}, {
