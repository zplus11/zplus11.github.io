Notebook[{
Cell[BoxData[
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{
   "Import", 
    "[", "\"\<C:\\\\Users\\\\Naman Taggar\\\\Desktop\\\\interactions.csv\>\"",
     "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9836641545892963`*^9, 3.9836641646897717`*^9}},
 CellLabel->"In[33]:=",ExpressionUUID->"e5ad9644-41ec-4d4a-ba65-2382c64b9871"],

Cell[BoxData[
 RowBox[{
  RowBox[{"rules", "=", 
   RowBox[{"DeleteDuplicatesBy", "[", 
    RowBox[{
     RowBox[{"Rule", "@@@", 
      RowBox[{"data", "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{"2", ";;"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "3"}], "}"}]}], "]"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"Sort", "[", 
       RowBox[{"List", "@@", "#"}], "]"}], "&"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9836641993377705`*^9, 3.9836642343305264`*^9}, {
  3.9836643623266163`*^9, 3.9836643982477474`*^9}},
 CellLabel->"In[34]:=",ExpressionUUID->"7948211c-81a9-a948-ba84-c857c441c2ef"],

Cell[BoxData[
 RowBox[{"G", "=", 
  RowBox[{"Graph", "[", 
   RowBox[{"rules", ",", 
    RowBox[{"DirectedEdges", "->", "False"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.983664235626402*^9, 3.9836642380569324`*^9}, {
  3.98366427612916*^9, 3.983664314230709*^9}},
 CellLabel->"In[35]:=",ExpressionUUID->"12f61340-87c2-c74d-a6e0-dab98334d02e"],

Cell["Two servers connected via me.", "Text",
 CellChangeTimes->{{3.983670985261894*^9, 
  3.9836709979433403`*^9}},ExpressionUUID->"cc5b1d31-50aa-a64d-927a-\
d347b1e476b8"],

Cell["Now we find communities in this graph", "Text",
 CellChangeTimes->{{3.983671011175186*^9, 
  3.983671015462858*^9}},ExpressionUUID->"cd5a2d7d-0ac5-d846-950a-\
5bb5142a2e23"],

Cell[BoxData[
 RowBox[{
  RowBox[{"coms", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Subgraph", "[", 
      RowBox[{"G", ",", "#"}], "]"}], "&"}], "/@", 
    RowBox[{"FindGraphCommunities", "[", "G", "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9836710173881626`*^9, 3.983671023826103*^9}, {
  3.983671123249861*^9, 3.9836711336284637`*^9}},
 CellLabel->"In[41]:=",ExpressionUUID->"3c7f854e-8239-834f-8a8d-026c02ccc4e0"],

