 CellLabel->"In[1]:=",ExpressionUUID->"cfd29cc5-feb2-9945-a92e-78e4de032b21"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"eqns", "[", 
   RowBox[{
    RowBox[{"\[Beta]_", ":", "\[Beta]"}], ",", 
    RowBox[{"\[Gamma]_", ":", "\[Gamma]"}]}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"s", "'"}], "[", "t", "]"}], "==", 
     RowBox[{
      RowBox[{"-", "\[Beta]"}], " ", 
      RowBox[{"s", "[", "t", "]"}], 
      RowBox[{"i", "[", "t", "]"}]}]}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"i", "'"}], "[", "t", "]"}], "==", 
     RowBox[{
      RowBox[{"\[Beta]", " ", 
       RowBox[{"s", "[", "t", "]"}], 
       RowBox[{"i", "[", "t", "]"}]}], "-", 
      RowBox[{"\[Gamma]", " ", 
       RowBox[{"i", "[", "t", "]"}]}]}]}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"r", "'"}], "[", "t", "]"}], "==", 
     RowBox[{"\[Gamma]", " ", 
      RowBox[{"i", "[", "t", "]"}]}]}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"init", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"s", "[", "0", "]"}], "==", "99"}], ",", 
     RowBox[{
      RowBox[{"i", "[", "0", "]"}], "==", "1"}], ",", 
     RowBox[{
      RowBox[{"r", "[", "0", "]"}], "==", "0"}]}], "}"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9831452256118927`*^9, 3.983145299111414*^9}, {
  3.983239477950077*^9, 3.9832394851216583`*^9}, {3.983240039784569*^9, 
