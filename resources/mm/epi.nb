Cell[BoxData[
 RowBox[{
  RowBox[{"eeqns", "[", 
   RowBox[{
   "\[Beta]_", ",", "\[Gamma]_", ",", "\[Lambda]1_", ",", "\[Lambda]2_", ",", 
    "a1_", ",", "a2_", ",", "a3_", ",", "b1_", ",", "b2_", ",", "b3_", ",", 
    "c1_", ",", "c2_", ",", "c3_", ",", "p1_", ",", "p2_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"s", "'"}], "[", "t", "]"}], "==", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "\[Beta]"}], " ", 
       RowBox[{"s", "[", "t", "]"}], 
       RowBox[{"i", "[", "t", "]"}]}], "+", 
      FractionBox[
       RowBox[{
        RowBox[{"\[Lambda]1", " ", "t"}], "+", "\[Lambda]2"}], "n"]}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"i", "'"}], "[", "t", "]"}], "==", 
     RowBox[{
      RowBox[{"\[Beta]", " ", 
       RowBox[{"s", "[", "t", "]"}], 
       RowBox[{"i", "[", "t", "]"}]}], "-", 
      RowBox[{"\[Gamma]", " ", 
       RowBox[{"i", "[", "t", "]"}]}], "+", 
      FractionBox[
       RowBox[{
        RowBox[{"a1", " ", "b1", " ", 
         RowBox[{"Cos", "[", 
          RowBox[{
           RowBox[{"b1", " ", "t"}], "+", "c1"}], "]"}]}], "+", 
        RowBox[{"a2", " ", "b2", " ", 
         RowBox[{"Cos", "[", 
          RowBox[{
           RowBox[{"b2", " ", "t"}], "+", "c2"}], "]"}]}], "+", 
        RowBox[{"a3", " ", "b3", " ", 
         RowBox[{"Cos", "[", 
          RowBox[{
           RowBox[{"b3", " ", "t"}], "+", "c3"}], "]"}]}]}], "n"]}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"r", "'"}], "[", "t", "]"}], "==", 
     RowBox[{
      RowBox[{"\[Gamma]", " ", 
       RowBox[{"i", "[", "t", "]"}]}], "+", 
      FractionBox[
       RowBox[{
        RowBox[{"p1", " ", "t"}], "+", "p2"}], "n"]}]}]}], "}"}]}]], "Input",
