Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"getTS", "[", 
    RowBox[{"raw_", ",", "country_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"row", ",", "dates", ",", "vals"}], "}"}], ",", 
     RowBox[{
      RowBox[{"row", "=", 
       RowBox[{"SelectFirst", "[", 
        RowBox[{
         RowBox[{"Rest", "[", "raw", "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "==", "country"}], "&"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"dates", "=", 
       RowBox[{"raw", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", 
          RowBox[{"5", ";;"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"vals", "=", 
       RowBox[{"row", "[", 
        RowBox[{"[", 
         RowBox[{"5", ";;"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"TimeSeries", "[", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"dates", ",", "vals"}], "}"}], "]"}], "]"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9831478164289*^9, 3.983147994851198*^9}, {
