Cell[BoxData[{
 RowBox[{
  RowBox[{"eqns", "[", 
   RowBox[{
    RowBox[{"\[Beta]_", ":", "\[Beta]"}], ",", 
    RowBox[{"\[Gamma]_", ":", "\[Gamma]"}]}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"s", "'"}], "[", "t", "]"}], "==", 
     RowBox[{
      RowBox[{"-", "\[Beta]"}], " ", 
      RowBox[{"s", "[", "t", "]"}], 
      RowBox[{"i", "[", "t", "]"}]}]}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"i", "'"}], "[", "t", "]"}], "==", 
     RowBox[{
      RowBox[{"\[Beta]", " ", 
       RowBox[{"s", "[", "t", "]"}], 
       RowBox[{"i", "[", "t", "]"}]}], "-", 
      RowBox[{"\[Gamma]", " ", 
       RowBox[{"i", "[", "t", "]"}]}]}]}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"r", "'"}], "[", "t", "]"}], "==", 
     RowBox[{"\[Gamma]", " ", 
      RowBox[{"i", "[", "t", "]"}]}]}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"init", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"s", "[", "0", "]"}], "==", "99"}], ",", 
     RowBox[{
      RowBox[{"i", "[", "0", "]"}], "==", "1"}], ",", 
     RowBox[{
      RowBox[{"r", "[", "0", "]"}], "==", "0"}]}], "}"}]}], ";"}]}], "Input",
