 CellLabel->"In[3]:=",ExpressionUUID->"fdfc8ce8-93c5-374e-ade0-9fc6ec56bf4f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"rel", "=", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"Tuples", "[", 
      RowBox[{"subs", ",", "2"}], "]"}], ",", 
     RowBox[{
      RowBox[{"SubsetQ", "@@", "#"}], "&"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9701240415797977`*^9, 3.9701240797972565`*^9}},
