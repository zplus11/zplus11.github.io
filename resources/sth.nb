Cell[BoxData[
 RowBox[{
  RowBox[{
   SubscriptBox["S", "5"], "=", 
   RowBox[{"MPermutationsGroup", "[", "5", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9701239830634937`*^9, 3.97012399069442*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"a7a3db78-1bdb-2d4c-9018-acdd5eda6c37"],

Cell[BoxData[
 RowBox[{
  RowBox[{"subs", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"MSubgroups", "[", 
      RowBox[{
       SubscriptBox["S", "5"], ",", 
       RowBox[{"MCombinationsLimit", "->", "2"}]}], "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";"}]], "Input",
